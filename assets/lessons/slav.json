{"format":2,"id":"slav","title":"Slav Defence","side":"black","start":"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","source":{"title":"Black repertoaire: Slav Defense","author":"MMatkun","url":"https://lichess.org/study/LGKgEao4"},"variations":{"slav":{"name":"Slav Defence"},"pure-slav":{"name":"Pure Slav","parent":"slav"},"semi-slav":{"name":"Semi-Slav","parent":"slav"},"semi-slav-5-e3":{"name":"Semi-Slav: 5.e3","parent":"semi-slav"},"semi-slav-5-bg5":{"name":"Semi-Slav: 5.Bg5","parent":"semi-slav"},"exchange-variation":{"name":"Exchange Variation","parent":"slav"},"4-qc2":{"name":"4.Qc2","parent":"slav"},"4-qb3":{"name":"4.Qb3","parent":"slav"}},"popularity":{"ratingBands":[1000,1200,1400,1600,1800],"speeds":["blitz","rapid","classical"],"date":"2026-11-19"},"positions":{
