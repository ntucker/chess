{
  "name": "opening-night",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@data-client/react": "^0.19.0",
    "@data-client/rest": "^0.19.0",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@lichess-org/chessground": "^10.5.0",
    "@reactive/silk-core": "file:./vendor/reactive-silk-core.tgz",
    "@reactive/silk-native": "file:./vendor/reactive-silk-native.tgz",
    "chessops": "^0.15.1",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "~0.88.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "stockfish": "19.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "vendor:silk": "node ./scripts/vendor-silk.mjs",
    "brand": "node ./scripts/make-brand.mjs",
    "maia": "node ./scripts/convert-maia.mjs",
    "stockfish": "node ./scripts/copy-stockfish.mjs",
    "postinstall": "node ./scripts/copy-stockfish.mjs",
    "import-study": "NODE_USE_ENV_PROXY=1 tsx scripts/import-study/index.ts",
    "index-lessons": "tsx scripts/import-study/reindex.ts",
    "cover-opponent": "NODE_USE_ENV_PROXY=1 tsx scripts/import-study/coverOpponent.ts"
  },
  "private": true,
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@reactive/silk-core": "file:./vendor/reactive-silk-core.tgz",
    "expo@npm:~58.0.26": "patch:expo@npm%3A58.0.26#~/.yarn/patches/expo-npm-58.0.26-ffd3f43c6e.patch"
  },
  "jest": {
    "projects": [
      {
        "displayName": "native",
        "preset": "jest-expo",
        "moduleNameMapper": {
          "^@/assets/(.*)$": "<rootDir>/assets/$1"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "\\.web\\.test\\.tsx?$"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@lichess-org|@reactive))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "setupFiles": [
          "<rootDir>/jest.web.setup.ts"
        ],
        "moduleNameMapper": {
          "^@/assets/(.*)$": "<rootDir>/assets/$1",
          "^@react-native/assets-registry/registry$": "<rootDir>/jest.web.assetsRegistry.ts"
        },
        "testMatch": [
          "<rootDir>/src/**/*.web.test.ts?(x)"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@lichess-org|@reactive))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "transform": {
          "\\.css$": "jest-expo/src/preset/assetFileTransformer.js"
        }
      }
    ]
  }
}
