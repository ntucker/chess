// The Maia proxy for the GitHub Pages build (see index.ts).
// .github/workflows/web.yml deploys it on every push to main, replacing
// ALLOWED_ORIGINS with the Pages site's origin. To deploy it by hand:
//   npx wrangler@4.163.0 deploy --config workers/maia-proxy/wrangler.jsonc \
//     --var ALLOWED_ORIGINS:https://<user>.github.io
{
  "name": "opening-night-maia",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Expo's dev server, for trying the Worker locally (`wrangler dev`).
    "ALLOWED_ORIGINS": "http://localhost:8081"
  }
}
